# F8 — Qwen3-VL deepstack compatibility fix for scripts/planning_eval_compress.py
#
# DO NOT APPLY BLINDLY. This is the diagnosis + proposed patch for the overnight
# orchestrator owner to review. The active SFT training must NOT be disturbed;
# this file only touches scripts/planning_eval_compress.py (an eval helper, NOT
# a training file).
#
# ============================================================================
# ROOT CAUSE (transformers 5.6 / Qwen3-VL, file:line citations)
# ============================================================================
# transformers/models/qwen3_vl/modeling_qwen3_vl.py:
#   * L1302-1306  Qwen3VLModel.forward calls get_video_features(...) and reads
#                 BOTH `.pooler_output` AND `.deepstack_features` from the
#                 returned object:
#                     video_embeds          = video_outputs.pooler_output
#                     deepstack_video_embeds = video_outputs.deepstack_features
#   * L819-822    Qwen3VLVisionModel.forward returns
#                 BaseModelOutputWithDeepstackFeatures(pooler_output=...,
#                 deepstack_features=deepstack_feature_lists)  — a LIST of
#                 len(deepstack_visual_indexes) tensors (==3 for 4B), each at the
#                 SAME post-merge token resolution as pooler_output.
#   * L1332-1335  video-only branch sets
#                     deepstack_visual_embeds = deepstack_video_embeds
#   * L1348-1356  these are forwarded into language_model(..., visual_pos_masks,
#                 deepstack_visual_embeds=...) and consumed by
#                 _deepstack_process (L941-951) which ADDS each deepstack tensor
#                 into hidden_states at the visual_pos_masks positions. The row
#                 count of every deepstack tensor MUST equal the (compressed)
#                 video-token count or the masked add shape-mismatches.
#
# scripts/planning_eval_compress.py (the breakage):
#   * L100-108  class _FakeVisOut exposes ONLY `.pooler_output`. It has NO
#               `.deepstack_features` attribute.
#   * L408      the monkey-patched get_video_features returns _FakeVisOut(...).
#       => On a Qwen3-VL ckpt, modeling_qwen3_vl.py:L1306
#          `video_outputs.deepstack_features` raises AttributeError immediately.
#       Even if a `.deepstack_features` attr were bolted on naively (e.g. echo
#       the raw pre-compression deepstack list), its rows (2880) would NOT match
#       the compressed pooler rows (e.g. 720), so masked_scatter (L1311) /
#       _deepstack_process (L941) would shape-mismatch. The deepstack tensors
#       must be pruned with the SAME kept-index set as the pooler.
#
# The docstring at planning_eval_compress.py:L45-57 already FLAGS this as
# UNVALIDATED for Qwen3-VL. This patch implements the alignment.
#
# ============================================================================
# FIX STRATEGY
# ============================================================================
# 1. _compress_per_item must return the KEPT INDEX TENSOR (per video block), not
#    just the compressed embeds, so the same indices can be applied to every
#    deepstack level. (FasterVLM/PruMerge/PyramidDrop are all top-k-by-norm
#    selections — a clean index subset exists; for PruMerge the merged residual
#    is folded into kept rows, and we reuse the kept top-k index set for the
#    deepstack levels, which is the alignment-preserving approximation.)
# 2. The patched get_video_features must call the original get_video_features to
#    obtain BOTH pooler_output AND deepstack_features, prune the pooler per
#    block, then prune each deepstack tensor with the matching kept indices, and
#    return a real BaseModelOutputWithDeepstackFeatures (or a _FakeVisOut that
#    also carries `.deepstack_features`) so L1306 + _deepstack_process succeed.
# 3. Guard for Qwen2.5-VL (no deepstack): if the vision output has no
#    deepstack_features (or it is None/empty), fall back to the current
#    pooler-only path so the script stays back-compatible.
#
# CPU DRY-TEST (mock tensors, run on /usr/bin/python3, NO GPU): for
# N_in=2880 post-merge video tokens with 3 deepstack levels, the corrected
# index-aligned pruning yields pooler_out == deep0 == deep1 == deep2 == target
# for every ratio:
#     ratio  target  pool_out  deep0  deep1  deep2  aligned
#       2     1440     1440     1440   1440   1440    True
#       4      720      720      720    720    720    True
#       8      360      360      360    360    360    True
#      16      180      180      180    180    180    True
#   baseline (ratio=1): pooler 2880, 3 deepstack levels, no pruning.
#
# ============================================================================
# UNIFIED DIFF (review, then apply with: git apply F8_planning_eval_compress.patch)
# ============================================================================
--- a/scripts/planning_eval_compress.py
+++ b/scripts/planning_eval_compress.py
@@ -100,11 +100,18 @@ from visual_compress import compress_visual_tokens  # noqa: E402  (spatial axis)
